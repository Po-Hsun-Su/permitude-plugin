{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_permitude_)?permitude__(read_reference|read_project|read_gallery|set_project|deck_build|report_issue)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/carry.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_permitude_)?permitude__(read_reference|read_project|set_project)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/redeem.py"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
