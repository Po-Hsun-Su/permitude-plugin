{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(deck_build|site_context|design_feedback|sheet_page|permit_packet|vendor_doc|sdk_update|gallery_list|gallery_design|report_issue)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/carry.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(site_context|permit_packet|sdk_update)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/redeem.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
